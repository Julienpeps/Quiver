# syntax=docker/dockerfile:1
# The verified Arch Linux ARM rootfs is downloaded by CI/local build tooling to
# images/base/rootfs/archlinuxarm-aarch64.tar.gz before this Dockerfile runs.
FROM scratch AS archlinuxarm-root

ARG ARCHLINUXARM_ROOTFS_SHA256

COPY images/base/rootfs/archlinuxarm-aarch64.tar.gz /rootfs.tar.gz
RUN test -n "$ARCHLINUXARM_ROOTFS_SHA256" \
    && echo "$ARCHLINUXARM_ROOTFS_SHA256  /rootfs.tar.gz" | sha256sum --check --status \
    && mkdir -p /root \
    && tar -xzf /rootfs.tar.gz -C /root \
    && rm -f /rootfs.tar.gz

FROM archlinuxarm-root

ARG BLACKARCH_STRAP_URL
ARG BLACKARCH_STRAP_SHA256

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN test -n "$BLACKARCH_STRAP_SHA256" \
    && test -n "$ARCHLINUXARM_ROOTFS_SHA256" \
    && pacman-key --init \
    && pacman-key --populate archlinuxarm \
    && pacman -Syu --noconfirm --needed \
        asciinema ca-certificates curl git iproute2 iptables-nft nftables \
        novnc openvpn python python-pyyaml supervisor tigervnc util-linux \
        websockify wireguard-go wireguard-tools xorg-xauth xterm \
        xfce4 xfce4-terminal zsh \
    && curl --fail --location --silent --show-error "$BLACKARCH_STRAP_URL" --output /tmp/strap.sh \
    && echo "$BLACKARCH_STRAP_SHA256  /tmp/strap.sh" | sha256sum --check --status \
    && chmod +x /tmp/strap.sh \
    && /tmp/strap.sh \
    && rm -f /tmp/strap.sh \
    && pacman -Scc --noconfirm

COPY images/common/entrypoint/quiver-entrypoint /usr/local/bin/quiver-entrypoint
COPY images/common/shell/quiver-record-shell /usr/local/bin/quiver-record-shell
COPY images/common/shell/quiver-audit-hook.zsh /usr/local/lib/quiver/quiver-audit-hook.zsh
COPY images/common/supervisor/quiver-vpn /usr/local/bin/quiver-vpn
COPY images/common/supervisor/quiver-killswitch.py /usr/local/lib/quiver/quiver-killswitch.py
COPY src/quiver/vpn/killswitch.py /usr/local/lib/quiver/killswitch.py
COPY images/common/gui/quiver-gui /usr/local/bin/quiver-gui
COPY images/common/supervisor/supervisord.conf /etc/supervisor/supervisord.conf
COPY images/common/entrypoint/generate-supervisor.py /usr/local/lib/quiver/generate-supervisor.py
COPY images/common/entrypoint/image.json /etc/quiver/image.json
COPY packages/base.yaml /etc/quiver/packages/base.yaml

RUN install -d -m 0755 /workspace /run/quiver /etc/supervisor/conf.d /opt \
    && printf '%s\n' '[[ -n ${QUIVER_SESSION_ID:-} ]] && source /usr/local/lib/quiver/quiver-audit-hook.zsh' > /etc/zsh/zshrc \
    && if [[ -d /usr/share/webapps/novnc ]]; then ln -s /usr/share/webapps/novnc /opt/novnc; fi \
    && test -d /opt/novnc \
    && chmod 0755 /usr/local/bin/quiver-entrypoint /usr/local/bin/quiver-record-shell \
        /usr/local/bin/quiver-vpn /usr/local/bin/quiver-gui \
        /usr/local/lib/quiver/quiver-killswitch.py \
    && chmod 0644 /usr/local/lib/quiver/quiver-audit-hook.zsh \
        /usr/local/lib/quiver/generate-supervisor.py /usr/local/lib/quiver/killswitch.py \
        /etc/quiver/image.json /etc/quiver/packages/base.yaml

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/quiver-entrypoint"]
